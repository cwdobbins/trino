    <build>

        <resources>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources</directory>
                <includes>
                    <include>io/trino/plugin/base/trino-spi-compile-time-version.txt</include>
                </includes>
            </resource>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>io/trino/plugin/base/trino-spi-compile-time-version.txt</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>stock-spi</id>
            <properties>
                <trino.spi.compile-time.version>484</trino.spi.compile-time.version>
            </properties>
        </profile>
    </profiles>
</project>
